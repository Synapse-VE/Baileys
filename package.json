{
  "name": "@synapse-ve/baileys",
  "type": "module",
  "version": "7.0.0-rc14.sync.3",
  "description": "Independent Baileys fork for WhatsApp Web, maintained by Synapse-VE",
  "keywords": [
    "whatsapp",
    "automation"
  ],
  "homepage": "https://github.com/Synapse-VE/Baileys#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synapse-VE/Baileys.git"
  },
  "license": "MIT",
  "author": "Rajeh Taher",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js",
    "scripts/patch-libsignal.cjs"
  ],
  "scripts": {
    "build:all": "npm run build && npm run build:docs",
    "build:docs": "typedoc",
    "build": "tsc -P tsconfig.build.json && tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js",
    "changelog:last": "conventional-changelog -p angular -r 2",
    "changelog:preview": "conventional-changelog -p angular -u",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "example": "tsx ./Example/example.ts",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "lint": "tsc && eslint src --ext .js,.ts",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "postinstall": "node scripts/patch-libsignal.cjs",
    "preinstall": "node ./engine-requirements.js",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --testMatch '**/*.test.ts'",
    "test:e2e": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --experimental-vm-modules ./node_modules/.bin/jest --runInBand --forceExit --testMatch '**/*.test-e2e.ts'",
    "test:proto": "node --test proto-extract/field-labels.test.js scripts/__tests__/generate-statics.test.mjs scripts/__tests__/proto-compat.test.mjs scripts/__tests__/proto-file.test.mjs",
    "test:scripts": "node --test scripts/__tests__/feature-watch.test.mjs scripts/__tests__/protocol-status.test.mjs",
    "watch:features": "node scripts/feature-watch.mjs",
    "status:protocol": "node scripts/protocol-status.mjs",
    "update:version": "tsx ./scripts/update-version.ts"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^12.3.4",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.6.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.9.0",
    "@types/ws": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@whiskeysockets/eslint-config": "^1.0.0",
    "conventional-changelog": "^7.1.1",
    "conventional-changelog-angular": "^8.0.0",
    "esbuild-register": "^3.6.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^30.5.2",
    "jimp": "^1.6.1",
    "jiti": "^2.4.2",
    "json": "^11.0.0",
    "link-preview-js": "^5.0.1",
    "lru-cache": "^11.1.0",
    "open": "^8.4.2",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.5.3",
    "protobufjs-cli": "^1.3.3",
    "ts-jest": "^29.4.0",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "4.4.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.1",
    "link-preview-js": "^5.0.1",
    "sharp": "*"
  },
  "resolutions": {
    "ajv@npm:^6.12.4": "^6.14.0",
    "basic-ftp": "^5.2.4",
    "brace-expansion@npm:^1.1.7": "^1.1.21",
    "brace-expansion@npm:^2.0.1": "^2.1.7",
    "flatted": "^3.4.2",
    "glob@npm:^10.2.2": "^10.5.0",
    "glob@npm:^10.3.10": "^10.5.0",
    "glob@npm:^10.5.0": "^10.5.0",
    "handlebars": "^4.7.10",
    "ip-address": "^10.7.6",
    "js-yaml@npm:^3.13.1": "^3.15.2",
    "js-yaml@npm:^4.1.0": "^4.3.2",
    "markdown-it": "^14.3.3",
    "minimatch@npm:^3.0.4": "^3.1.5",
    "minimatch@npm:^3.1.2": "^3.1.5",
    "minimatch@npm:^5.0.1": "^5.1.8",
    "minimatch@npm:^9.0.4": "^9.0.9",
    "minimatch@npm:^9.0.5": "^9.0.9",
    "picomatch@npm:^2.0.4": "^2.3.2",
    "picomatch@npm:^2.3.1": "^2.3.2",
    "picomatch@npm:^4.0.0": "^4.0.4",
    "picomatch@npm:^4.0.2": "^4.0.4",
    "socks": "^2.8.8",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "underscore": "^1.13.8",
    "yaml@npm:^2.6.1": "^2.8.4",
    "protobufjs": "^7.6.6",
    "brace-expansion@npm:^2.0.2": "^2.1.7",
    "browserslist": "^4.29.5",
    "lodash": "^4.18.1",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "bugs": {
    "url": "https://github.com/Synapse-VE/Baileys/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
